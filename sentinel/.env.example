# ─────────────────────────────────────────────────────────────────────
#  Sentinel configuration.  cp .env.example .env  and edit.
#  Every value here has a working default, so `docker compose up` works
#  with no .env at all. Set these for anything beyond a laptop demo.
# ─────────────────────────────────────────────────────────────────────

# demo | development | production
# production REFUSES to start without SECRET_KEY, or with a weak database
# password. That is deliberate: a demo secret reaching production is the
# single most common way a system like this is compromised.
ENVIRONMENT=demo

# ── secrets ──────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
SECRET_KEY=
POSTGRES_PASSWORD=sentinel-demo-password
# Leave blank and the seeder generates one and prints it once.
SEED_ADMIN_PASSWORD=
GRAFANA_PASSWORD=sentinel

# ── database ─────────────────────────────────────────────────────────
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel

# ── ingestion ────────────────────────────────────────────────────────
# demo   : the 50-camera traffic world. No cameras required.
# live   : only the cameras in config/cameras.yaml
# hybrid : both. Use this at the venue so a network failure cannot end
#          the demonstration.
INGEST_MODE=demo

# ── Sentinel gateway (PART 3) ────────────────────────────────────────
# Point this at the sandbox and the camera estate is DISCOVERED from
# GET <url>/api/ingest. No camera list is compiled into the application,
# and you never edit source to add or remove a camera.
#
#   SENTINEL_CATALOGUE_URL=https://<sandbox-host>
#   INGEST_MODE=live          # or hybrid, to keep the demo estate alongside
#
# The token, if the sandbox needs one, is a secret: put the real value here
# in your own .env, never in git.
#   SENTINEL_API_TOKEN=...
# If the streams need camera credentials, name a secret rather than
# inlining one:
#   SENTINEL_CREDENTIAL_REF=env:SENTINEL_GATEWAY_CRED
SENTINEL_CATALOGUE_URL=
SENTINEL_API_TOKEN=
SENTINEL_CREDENTIAL_REF=
SENTINEL_POLL_SECONDS=60
DEMO_VEHICLE_COUNT=1800
DEMO_TICK_HZ=6
DEMO_TIME_SCALE=3
DEMO_TARGET_PLATE=GJ01AB1234

# ── AI ───────────────────────────────────────────────────────────────
# simulation : no weights, no GPU. Runs anywhere.
# onnx       : real models. See ai/README.md for weights and export.
AI_BACKEND=simulation
AI_DEVICE=auto
AI_TARGET_FPS=6

# ── real camera credentials ──────────────────────────────────────────
# Referenced from config/cameras.yaml as credential_ref: env:SENTINEL_CAM_XXX
# Format is username:password. NEVER put these in cameras.yaml itself --
# the loader refuses inline credentials when ENVIRONMENT=production.
# SENTINEL_CAM_AHM101=viewer:the-real-password
# SENTINEL_CAM_AMCDVR3=admin:another-password

# ── misc ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MEDIA_BASE_URL=http://localhost:8889
