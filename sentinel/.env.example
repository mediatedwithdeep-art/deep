# Copy to .env and fill in. Never commit .env.
# In production every value here moves to Vault/OpenBao and is leased to
# services with a short TTL — see docs/04-legacy-integration.md §2.3.

PG_PASSWORD=change-me-in-production
MINIO_USER=sentinel
MINIO_PASSWORD=change-me-in-production
GRAFANA_PASSWORD=admin

# Default credentials used when probing a newly discovered camera.
# These are a bootstrap convenience for the prototype ONLY. Real camera
# credentials belong in Vault, referenced by camera.credential_ref.
DEFAULT_CAM_USER=viewer
DEFAULT_CAM_PASSWORD=
